# tania-core local development. Copy to .env.dev (gitignored):
#   cp .env.dev.example .env.dev
# or, to resolve the commented op:// references: op inject -i .env.dev.example -o .env.dev
#
# Nothing here is a secret. Tania is self-contained (SQLite, built-in OAuth), so the dev
# environment needs no third-party credentials to run.

TANIA_CORE_WEB_PORT=4180

# false matches production: the API requires a token, login is tania / tania (the default
# user main.go creates on first start). true bypasses auth with the upstream demo token.
DEMO_MODE=false

# Must list the origin the browser uses, or the implicit-grant login is rejected.
REDIRECT_URI=http://localhost:4180,http://127.0.0.1:4180

# Sentry stays off with an empty DSN (main.go skips sentry.Init).
# No 1Password item holds the tania DSN yet: today it exists only as the tania repo's
# GitHub Actions secret SENTRY_DSN. Once it is added to 1Password, use:
# SENTRY_DSN=op://GRCN Dev/<item>/dsn
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
